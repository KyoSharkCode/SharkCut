// Recursos de Windows: icono del ejecutable (y de las ventanas) y datos de la versión.
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/icons/sharkcut.ico"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0C0A04B0"
        BEGIN
            VALUE "CompanyName", "KyoSumiVT"
            VALUE "FileDescription", "SharkCut, editor de video"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "ProductName", "SharkCut"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "OriginalFilename", "SharkCut.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0C0A, 1200
    END
END
